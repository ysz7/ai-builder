# The environment this project runs in. A node on the graph: shown, opened, edited, never
# coloured -- there is nothing here a run could prove.
#
# Nothing here is a credential. OFFLINE=true is why: the agent answers from its own tools,
# so there is no key to hold. Set it false and put your own key in your own environment.

# agent/settings.py
MODEL=ollama/llama3.1
STEPS=3
OFFLINE=true

# agent/notes_settings.py
NOTES_PATH=.agent-notes.txt
