# The environment this project runs in. A node on the graph: shown, opened, edited, never
# coloured -- there is nothing here a run could prove.
#
# Nothing here is a credential. This project talks to nothing that needs one.

# rag/settings.py
INDEX_PATH=.rag-index.json
CHUNK_SIZE=400
TOP_K=3

# api/settings.py
UPLOAD_DIR=uploads
PAGE_SIZE=10
