# The environment this project runs in. A node on the graph: shown, opened, edited, never
# coloured -- there is nothing here a run could prove.
#
# Nothing secret belongs in this file in the repository. A real deployment overrides these.

# Which stack the chat writes a new system on, when the request does not say.
FRAMESTACK_DEFAULT_STACK_AGENT=plain
FRAMESTACK_DEFAULT_STACK_RAG=chroma
FRAMESTACK_DEFAULT_STACK_API=fastapi
FRAMESTACK_DEFAULT_STACK_WORKER=arq

# rag/settings.py
CHUNK_SIZE=500
TOP_K=4

# api/settings.py
PAGE_SIZE=20
DEBUG=false

# repositories/settings.py
DATABASE_URL=postgresql+psycopg://reference:reference@localhost:5432/reference
ECHO_SQL=false

# worker/settings.py
QUEUE=default
